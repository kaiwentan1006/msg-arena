# Server Config
PORT=3000
HOST=0.0.0.0

# Display name for this server (shown in multi-server sidebar)
SERVER_NAME=MSG Arena

# ── Software updates — the ONE line to point at your own releases ─────────
# The admin "Check for updates" button and the "a new version is available"
# banner check THIS repository. Set it to YOUR release repo so MSG Arena updates
# from your own source, not anyone else's. Two accepted forms:
#   UPDATE_REPO=your-org/MSG-Arena
#     GitHub shorthand — the check hits
#     https://api.github.com/repos/your-org/MSG-Arena/releases/latest
#   UPDATE_REPO=https://api.github.com/repos/your-org/MSG-Arena/releases/latest
#     A full releases-API URL — use this for GitHub Enterprise, Gitea, GitLab,
#     or any host that returns JSON with tag_name / html_url / body.
# Leave it blank (the default) and update checks are OFF — the server never
# contacts anyone. Nothing else needs editing; the download link and the
# git/docker/installer update commands all follow from here.
# UPDATE_REPO=your-org/MSG-Arena

# Secret key for JWT tokens — CHANGE THIS to a long random string!
# (Auto-generated on first boot if left as default)
JWT_SECRET=change-me-to-something-random-and-long

# Your admin username (register with this name first to get admin powers)
ADMIN_USERNAME=admin

# Optional: HTTPS (required for voice chat over the internet)
# Paths are relative to the data directory:
#   Windows: %APPDATA%\Haven\
#   Linux/macOS: ~/.haven/
#
# Using Let's Encrypt or certbot? Point this at fullchain.pem, NOT at their
# cert.pem. Their cert.pem holds only your own certificate, without the
# intermediate one above it, and a server that hands out just the leaf gets
# rejected by curl, by most automated link checkers, and by some mobile and
# API clients. Browsers usually hide the problem by fetching the missing
# piece themselves, so the site looks fine in Chrome while other things fail
# against it. MSG Arena's own setup-ssl script already copies fullchain.pem into
# certs/cert.pem, so the default path below is fine.
#   SSL_CERT_PATH=/etc/letsencrypt/live/YOUR.DOMAIN/fullchain.pem
#
# SSL_CERT_PATH=./certs/cert.pem
# SSL_KEY_PATH=./certs/key.pem

# Force HTTP mode (useful behind a reverse proxy like Caddy, nginx, etc.)
# Set to true to skip SSL even if certificates exist.
# FORCE_HTTP=false

# Reverse-proxy hop count for reading the real client IP from X-Forwarded-For.
# Default is 0 — trust NOTHING. Leave it at 0 for any direct-exposure setup
# (Start MSG Arena.bat, port forwarding, Cloudflare Tunnel): trusting a proxy hop
# that isn't there lets a client forge X-Forwarded-For to set its own IP and
# walk past IP bans, the login rate limiter and every other per-IP limit.
# Set this ONLY when a reverse proxy actually sits in front of MSG Arena:
#   TRUST_PROXY=1   one proxy (nginx / Traefik / Caddy / a single Cloudflare hop)
#   TRUST_PROXY=2   two proxies chained, etc.
# TRUST_PROXY=0

# Public-facing URL for OAuth/OpenID callbacks.
# Set this when the server cannot determine its own external address —
# for example Docker port mapping (8080→3000), reverse proxies that strip
# the port, or Cloudflare Tunnels. Must include the scheme (https://).
# Example: PUBLIC_URL=https://haven.example.com:8443
# PUBLIC_URL=

# Search-engine indexing. The public landing page (/) is served with canonical
# tags, Open Graph/Twitter cards, JSON-LD, robots.txt and sitemap.xml — all built
# from PUBLIC_URL, so set PUBLIC_URL for correct SEO. The app itself (/app) and
# the API are always kept out of search. To keep the WHOLE site out of search
# engines (private community), set NOINDEX=true — robots.txt then disallows all
# and the landing page is marked noindex.
# NOINDEX=false

# Twitch — shows a "🔴 Live" badge on profiles and in the member list while a
# linked user is streaming. Register a free app at
# https://dev.twitch.tv/console/apps/create with the OAuth redirect URL
# https://<your-host>/connect/twitch/callback , then paste its credentials here.
# Once set, users link Twitch under Settings → Connections.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# Steam Web API Key — required for Steam rich presence (game activity display).
# Get yours at https://steamcommunity.com/dev/apikey (any domain name works).
# Once set, users can link their Steam account in Settings → Connections.
# STEAM_API_KEY=

# ── Mobile push (FCM) ────────────────────────────────────
# Mobile (Android) push uses Firebase Cloud Messaging. Browser push works
# without any of this via Web Push/VAPID (auto-generated on first boot).
#
# FCM is OFF unless you configure it, because relay mode forwards the sender,
# channel name and a short message preview to the relay you point it at.
# Two ways to turn it on:
#   1. Drop a Firebase service-account JSON in the data dir (direct mode —
#      previews go only to your own Firebase project), or
#   2. Point at a relay:
#        FCM_RELAY_URL=https://your-relay.example.com/sendPush
#        FCM_PUSH_KEY=your-relay-shared-secret
#
# To use the upstream maintainer's shared "Haven Global Relay" (message
# previews leave your server — opt in knowingly):
#   FCM_USE_GLOBAL_RELAY=true

# Optional: Override the data directory location
# HAVEN_DATA_DIR=

# Optional: let bot callback URLs point at private or local addresses.
# By default MSG Arena refuses to call back to 10.x, 172.16-31.x, 192.168.x,
# localhost, .local and .internal, so a webhook can't be used to probe the
# network the server sits on. Set this to true if your bot genuinely runs
# on the same LAN or in a sibling Docker container. Cloud metadata
# addresses (169.254.x.x) stay blocked either way.
# HAVEN_ALLOW_PRIVATE_CALLBACKS=true

# Optional: Override STUN servers for voice/WebRTC.
# Default: stun.stunprotocol.org + stun.nextcloud.com
# Comma-separated list of STUN URIs. Set this to point at your own coturn
# or any STUN server for fully self-hosted voice with no external dependencies.
# STUN_URLS=stun:your-server.com:3478,stun:backup-server.com:3478

# ── Voice SFU (optional; scales voice past the ~5-8 P2P mesh cap) ─────────
# Turn SFU mode on from Settings → Admin → Voice scaling (SFU). When enabled,
# voice is forwarded through THIS server (one upload per person) instead of
# peer-to-peer, so calls scale to large rooms — at the cost that the server can
# see the media. It needs the media UDP port reachable from the internet, the
# same as a TURN server. By default an ephemeral UDP port is used; pin it to a
# fixed range you can forward on your firewall with:
# SFU_UDP_PORT_RANGE=50000-50100
# See docs/voice-sfu.md for the full explanation.

# Optional: TURN server for voice/screen sharing across the internet.
# Without TURN, voice only works on the same network (LAN).
# Recommended: run coturn on the same box or a cheap VPS.
#
# Option A — Shared secret (coturn --use-auth-secret, recommended):
# TURN_URL=turn:your-server.com:3478
# TURN_SECRET=your-coturn-static-auth-secret
#
# Option B — Static credentials:
# TURN_URL=turn:your-server.com:3478
# TURN_USERNAME=haven
# TURN_PASSWORD=your-password

# Optional: Tenor API key for GIF search (free — enable the Tenor API and create
# an API key at https://console.cloud.google.com/)
# TENOR_API_KEY=
# Optional: GIPHY API key (legacy — GIPHY no longer issues keys to new apps)
# GIPHY_API_KEY=

# ── Dynamic DNS auto-updater ─────────────────────────────
# Keeps a DNS record pointed at this server's current public IP so your
# domain (e.g. anchaven.duckdns.org) never goes stale when your ISP
# rotates your IP. Disabled unless DDNS_PROVIDER is set.
#
# DuckDNS:
#   DDNS_PROVIDER=duckdns
#   DDNS_DOMAINS=your-subdomain           (no .duckdns.org, comma-separated for multiple)
#   DDNS_TOKEN=your-duckdns-token         (from https://www.duckdns.org/)
#
# Cloudflare:
#   DDNS_PROVIDER=cloudflare
#   DDNS_CF_API_TOKEN=...                 (token with Zone:DNS:Edit on the zone)
#   DDNS_CF_ZONE_ID=...
#   DDNS_CF_RECORD_ID=...
#   DDNS_CF_RECORD_NAME=haven.example.com
#
# Generic (anything that takes the IP in a URL):
#   DDNS_PROVIDER=generic
#   DDNS_URL=https://example.com/update?host=h&ip={ip}
#
# Common:
#   DDNS_INTERVAL_MINUTES=5               (how often to re-check; default 5)

# Checks unicode.org every month for a new emoji standard and automatically regenerates the built-in emojis in MSG Arena based on that standard
# If you choose to leave this feature disabled, MSG Arena will default to Unicode standard 16.0 which is bundled with the server
# Uncomment to enable this feature
# UNICODE_EMOJI_AUTO_UPDATE=true

# Your client secret as defined by your OIDC provider. The client secret must be set as an env var if using OIDC.
#   OIDC_CLIENT_SECRET=changeme-client-secret

# Disk headroom kept free on the data volume, in MB (default 512).
# Uploads are refused once accepting the largest allowed file would cut into
# this, so a full disk can never leave admins unable to delete the files that
# filled it (deleting a row is itself a database write, and that needs space).
# HAVEN_DISK_RESERVE_MB=512

# Full text search tokenizer. Controls how message text is matched.
# Takes effect on restart; changing it triggers a one time reindex.
#   trigram    Matches text anywhere inside words, so apple finds apple,
#              applesauce and pineapple. Most flexible for partial matches.
#              Largest index (about 3 to 4x the message text) and needs
#              queries of at least 3 characters.
#   unicode61  Whole word and prefix matching, so apple finds apple and
#              apple* but not applesauce. Smallest, fastest index with the
#              best relevance ranking.
#   porter     Like unicode61 plus English stemming, so run also finds
#              running and ran. Small index, English focused, still no
#              substring matches.
# Default is unicode61, the closest match to how Discord search behaves.
# HAVEN_SEARCH_TOKENIZER=unicode61
